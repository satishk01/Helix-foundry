# Run scripts/setup.sh to generate secrets. Do not use example values.
ENCRYPTION_KEY=
INTERNAL_KEY=
APP_ORIGIN=http://localhost:5173
HELIX_URL=http://127.0.0.1:6996
# Native dev without Docker (e.g. Windows): run HelixDB embedded in-process.
# Data lands in HELIX_DIR (default DATA_DIR/helix); HELIX_URL is then ignored.
# HELIX_EMBEDDED=true
# HELIX_DIR=.data/helix
EXECUTOR_URL=http://127.0.0.1:3002
OLLAMA_URL=http://127.0.0.1:11434
DATA_DIR=.data
# Compose: the browser origin. There is no sign-in, so keep it on this computer.
PUBLIC_ORIGIN=http://localhost:3001
PUBLIC_PORT=3001
# Multi-person deployment: require email+password sign-in instead of the
# single-computer local identity. The first user signs up through
# /api/v1/auth/bootstrap; owners then add members per workspace.
# REQUIRE_LOGIN=true
# MODEL_ENDPOINT=http://host.docker.internal:11434
# Executor limits; unset means the default. The time limits are whole or
# decimal seconds from 1 to 86400. See "Deployment limits" in docs/OPERATIONS.md.
# DUCKDB_SPILL_LIMIT=20GB
# EXECUTOR_RESULT_LIMIT=2GB
# EXECUTOR_QUERY_TIMEOUT=120
# EXECUTOR_JOB_TIMEOUT=900
# Compose memory budgets and model keep-alive (docs/OPERATIONS.md#memory).
# OLLAMA_MEMORY_LIMIT=6g
# HELIX_MEMORY_RESERVATION=2g
# MODEL_KEEP_ALIVE=30s
# Remote store for immutable dataset snapshots (docs/OPERATIONS.md#snapshot-storage).
# s3://bucket/prefix uses the AWS credential chain (SNAPSHOT_REGION or AWS_REGION,
# or SNAPSHOT_ACCESS_KEY_ID and SNAPSHOT_SECRET_ACCESS_KEY). An Azure Blob
# container URL with a SAS token uses plain HTTPS. Unset keeps snapshots local.
# SNAPSHOT_URI=s3://my-bucket/foundry
# SNAPSHOT_URI=https://<account>.blob.core.windows.net/<container>/foundry?<sas>
# SNAPSHOT_REGION=us-east-1
# SNAPSHOT_ACCESS_KEY_ID=
# SNAPSHOT_SECRET_ACCESS_KEY=
# Endpoint for S3-compatible stores such as MinIO; empty uses AWS.
# SNAPSHOT_ENDPOINT=http://minio:9000
# Local cache cap for hydrated snapshots; unset keeps every snapshot locally.
# SNAPSHOT_CACHE_LIMIT=20GB
# Optional provider sign-in. Register each integration and its workspace callback URL.
# See docs/HOSTING.md. Leave blank to use provider API keys or direct connections.
NEON_CLIENT_ID=
NEON_CLIENT_SECRET=
SUPABASE_CLIENT_ID=
SUPABASE_CLIENT_SECRET=
PLANETSCALE_CLIENT_ID=
PLANETSCALE_CLIENT_SECRET=
